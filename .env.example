# Copy to .env.local for local development. In Vercel, set these per environment
# (Production / Preview / Development). Never commit real values.

# ——— Site ———
# The live domain, no trailing slash. Canonicals, sitemap and social cards use it.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Only needed outside Vercel: "production" makes the site indexable. Vercel sets VERCEL_ENV itself.
# SITE_ENV=production
# Set to "warn" to let a production build through with launch-check blockers (deliberate soft launch only).
# LAUNCH_CHECK=warn

# ——— Studio facts (shown on the site) ———
STUDIO_LEGAL_NAME=
STUDIO_REGISTRATION_NO=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only, international format without "+", e.g. 60123456789
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GBP_URL=

# ——— Enquiries: Supabase (server only, never NEXT_PUBLIC) ———
SUPABASE_URL=
# The secret key (sb_secret_...) or the legacy service_role key. Server-side only.
SUPABASE_SECRET_KEY=
# Any long random string. Used to hash IPs for rate limiting.
ENQUIRY_IP_SALT=

# ——— Enquiries: email notification via Resend (optional) ———
RESEND_API_KEY=
# Comma-separated recipients
ENQUIRY_NOTIFY_TO=
# A sender on a domain verified in Resend, e.g. "ROUANG website <enquiries@example.com>"
ENQUIRY_NOTIFY_FROM=

# ——— Spam protection: Cloudflare Turnstile (optional) ———
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ——— Analytics and search ———
# GA4 measurement ID (G-XXXXXXX). Loaded only in production and only after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (or verify by DNS instead)
GOOGLE_SITE_VERIFICATION=
