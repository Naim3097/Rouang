# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent config
.claude/settings.local.json
!.env.example
.next-*/

# Hero render outputs before publishing: scripts/render/o-installation/site-geometry.cjs
# publishes content-hashed copies of these, which are what the site uses
/public/images/hero/o-installation-desktop.webp
/public/images/hero/o-installation-portrait.webp
/public/images/hero/o-scenery.jpg
